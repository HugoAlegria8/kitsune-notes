# Variables de entorno del servicio n8n (Render · «Environment»). Este fichero es solo
# un ejemplo SIN secretos: los valores reales se escriben en Render y nunca en GitHub.
# Genera cada secreto con:  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"

# --- n8n -----------------------------------------------------------------------
N8N_PORT=10000
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PROTOCOL=https
N8N_HOST=TU-SERVICIO.onrender.com
N8N_EDITOR_BASE_URL=https://TU-SERVICIO.onrender.com/
N8N_WEBHOOK_URL=https://TU-SERVICIO.onrender.com/
WEBHOOK_URL=https://TU-SERVICIO.onrender.com/
N8N_PROXY_HOPS=1
# Clave con la que n8n cifra las credenciales guardadas. NO la cambies después.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# Los nodos Code leen los secretos de aquí ($env) y firman con el módulo crypto.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
# Historial de ejecuciones: se guarda todo 14 días (trazabilidad).
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# --- Base de datos de n8n (Supabase · «Connect» → «Session pooler») ---------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.TU_PROYECTO
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# --- Kitsune: direcciones -----------------------------------------------------
KITSUNE_URL_N8N=https://TU-SERVICIO.onrender.com
KITSUNE_URL_TIENDA=https://kitsunenotes.davidalegria.eu
KITSUNE_URL_GESTION=https://gestion-kitsune.davidalegria.eu

# --- Kitsune: claves y secretos (deben coincidir con los .env de cada sistema) ----
# = KN_API_TOKEN del .env de la tienda
KITSUNE_TOKEN_TIENDA=
# = KG_CLAVE_N8N y KG_CLAVE_AGENTE del .env del back-office
KITSUNE_CLAVE_GESTION=
KITSUNE_CLAVE_AGENTE=
# = KN_WEBHOOK_SECRET de la tienda (firma de los eventos de la tienda)
KITSUNE_SECRETO_TIENDA=
# = KG_N8N_SECRETO del back-office (firma de los cambios del back-office)
KITSUNE_SECRETO_GESTION=
# = KN_TELEGRAM_LINK_SECRET de la tienda (enlace que vincula el pedido con Telegram)
KITSUNE_SECRETO_TELEGRAM=
# Solo de n8n: protege la llamada interna del flujo 01 al agente (flujo 02)
KITSUNE_SECRETO_AGENTE=

# --- Telegram -----------------------------------------------------------------
KITSUNE_TELEGRAM_API=https://api.telegram.org
# Token que da @BotFather
KITSUNE_TELEGRAM_TOKEN=
# Secreto que Telegram envía en cada llamada (el mismo que se pone en setWebhook)
KITSUNE_TELEGRAM_WEBHOOK_SECRET=
# Chat del equipo para los avisos (el bot lo dice con el comando /equipo)
KITSUNE_TELEGRAM_CHAT_EQUIPO=

# --- Agente de IA ---------------------------------------------------------------
# Modelo de Groq con herramientas (la clave va en la credencial de n8n, no aquí)
KITSUNE_MODELO=openai/gpt-oss-120b
