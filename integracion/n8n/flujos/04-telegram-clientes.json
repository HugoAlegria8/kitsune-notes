    {
      "parameters": {
        "jsCode": "// Telegram firma cada llamada con el secret_token registrado en setWebhook.\nconst crypto = require('crypto');\nconst h = $json.headers || {};\nconst u = $json.body || {};\nconst secreto = $env.KITSUNE_TELEGRAM_WEBHOOK_SECRET || '';\nif (!secreto || h['x-telegram-bot-api-secret-token'] !== secreto) {\n  return [{ json: { accion: 'ignorar', motivo: 'Llamada sin el secreto del webhook de Telegram.' } }];\n}\nconst m = u.message || u.edited_message;\nif (!m || !m.chat || typeof m.text !== 'string') return [{ json: { accion: 'ignorar', motivo: 'Actualización sin texto.' } }];\nconst texto = m.text.trim();\nlet accion = 'mensaje', referencia = null;\nif (/^\\/start\\s+\\S+/.test(texto)) {\n  // Enlace del pedido: KN-AAAA-NNNNNN_ + 12 caracteres de HMAC-SHA256 con el secreto compartido con la tienda.\n  const p = texto.split(/\\s+/)[1].match(/^(KN-\\d{4}-\\d{6})_([0-9a-f]{12})$/);\n  const esperada = p ? crypto.createHmac('sha256', $env.KITSUNE_SECRETO_TELEGRAM || '').update('telegram|' + p[1]).digest('hex').slice(0, 12) : '';\n  if (p && $env.KITSUNE_SECRETO_TELEGRAM && crypto.timingSafeEqual(Buffer.from(esperada), Buffer.from(p[2]))) { accion = 'vincular'; referencia = p[1]; }\n  else accion = 'codigo_invalido';\n} else if (/^\\/(start|ayuda|help)\\b/.test(texto)) accion = 'ayuda';\nelse if (/^\\/estado\\b/.test(texto)) accion = 'estado';\nelse if (/^\\/equipo\\b/.test(texto)) accion = 'equipo';\nelse if (m.chat.type !== 'private') accion = 'ignorar';\nconst idioma = String((m.from && m.from.language_code) || 'es').startsWith('en') ? 'en' : 'es';\nreturn [{ json: { accion, chat_id: String(m.chat.id), texto: texto.slice(0, 2000), referencia, idioma } }];\n"
      },
