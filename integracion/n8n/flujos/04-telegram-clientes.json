    {
      "parameters": {
        "jsCode": "// Textos fijos (no los escribe la IA): responden a acciones del propio cliente.\nconst m = $('Leer el mensaje de Telegram').first().json;\nconst r = $json || {};\nconst s = Number(r.statusCode || 0);\nconst b = (r.body && typeof r.body === 'object') ? r.body : {};\nconst en = m.idioma === 'en';\nlet texto;\nif (m.accion === 'vincular') {\n  if (s === 200) texto = b.idioma === 'en'\n    ? `Hi ${b.cliente_nombre}! You're all set: we'll send updates about order ${b.pedido_referencia} here. Current status: ${b.estado_pedido}.`\n    : `¡Hola, ${b.cliente_nombre}! Listo: te avisaremos por aquí de tu pedido ${b.pedido_referencia}. Estado actual: ${b.estado_pedido}.`;\n  else if (s === 404) texto = en ? 'We cannot find that order yet. Please try again in a minute.' : 'Todavía no encontramos ese pedido. Prueba de nuevo en un minuto.';\n  else texto = en ? 'Sorry, we could not link this chat right now.' : 'Ahora mismo no hemos podido vincular este chat. Inténtalo más tarde.';\n} else if (m.accion === 'estado') {\n  texto = s === 200\n    ? ((b.pedidos || []).length ? 'Tus pedidos:\\n' + b.pedidos.map(p => `· ${p.referencia}: ${p.estado} (${p.total})`).join('\\n') : 'No tienes pedidos todavía.')\n    : 'Este chat no está vinculado a ningún pedido. Abre el enlace de Telegram desde la página de tu pedido en la tienda.';\n} else if (m.accion === 'mensaje') {\n  texto = s === 200\n    ? `Gracias, ${b.cliente_nombre}. ${b.nueva ? 'Hemos abierto la consulta' : 'Lo hemos añadido a tu incidencia'} #${b.incidencia_id}; el equipo te contestará por aquí.`\n    : 'Para escribirnos por aquí, abre primero el enlace de Telegram desde la página de tu pedido en la tienda.';\n} else if (m.accion === 'equipo') {\n  texto = `Identificador de este chat: ${m.chat_id}\\nPara recibir aquí los avisos del equipo, ponlo en la variable KITSUNE_TELEGRAM_CHAT_EQUIPO de n8n.`;\n} else if (m.accion === 'codigo_invalido') {\n  texto = en ? 'That link is not valid. Open it again from your order page.' : 'Ese enlace no es válido. Ábrelo de nuevo desde la página de tu pedido.';\n} else {\n  texto = en ? 'Hi! This is the Kitsune Notes demo bot (academic prototype). Open the Telegram link on your order page to get updates here. Command: /estado'\n             : '¡Hola! Soy el bot de pruebas de Kitsune Notes (prototipo académico). Abre el enlace de Telegram de la página de tu pedido para recibir avisos aquí. Comando: /estado';\n}\nconst ok = ['ayuda', 'equipo', 'codigo_invalido'].includes(m.accion) || (s >= 200 && s < 300);\nreturn [{ json: { chat_id: m.chat_id, texto, accion: m.accion, resultado: ok ? 'ok' : 'error', codigo_backoffice: s || null } }];\n"
      },
