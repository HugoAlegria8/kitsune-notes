# -------------------------------------------------------------------
# Kitsune Notes - variables de entorno
#
# Copia este fichero como «.env» y ajusta los valores. El fichero .env
# NO se sube al repositorio (está en .gitignore): es el mecanismo por el
# que la entrega no contiene ninguna credencial.
# -------------------------------------------------------------------

KN_APP_NAME="Kitsune Notes"
KN_APP_ENV=local
KN_APP_DEBUG=1

# --- Base de datos ---------------------------------------------------
# sqlite (por defecto, sin configuración) o mysql (hosting compartido).
KN_DB_DRIVER=sqlite

# Solo para sqlite: ruta del fichero de base de datos.
# KN_DB_PATH=/ruta/absoluta/storage/database/kitsune.sqlite

# Solo para mysql:
# KN_DB_DRIVER=mysql
# KN_DB_HOST=localhost
# KN_DB_PORT=3306
# KN_DB_NAME=kitsune_notes
# KN_DB_USER=usuario_de_tu_hosting
# KN_DB_PASS=contraseña_de_tu_hosting

# --- Seguridad -------------------------------------------------------
# Contraseña del back-office de demostración (usuario admin@kitsunenotes.test).
KN_ADMIN_PASSWORD=kitsune-demo-2026

# Sal para seudonimizar la IP en los eventos. Cámbiala por una cadena
# aleatoria propia antes de desplegar.
KN_EVENT_SALT=cambia-esta-cadena-por-una-aleatoria

# Token del API interno de eventos (/api/eventos).
KN_API_TOKEN=token-demo-tarea2

# --- Facturas y correos ----------------------------------------------
# URL pública de la tienda (enlaces de los correos). Déjala vacía en local.
# KN_APP_URL=https://midominio.es/tienda

# Remitente de los correos (por defecto, dirección de prueba con el dominio
# reservado .test). Con el envío real activado, pon aquí tu propia cuenta.
# KN_MAIL_FROM=pedidos@kitsunenotes.test
# KN_MAIL_FROM_NAME="Kitsune Notes"

# Clave que firma los enlaces a la factura de los correos. Cámbiala.
KN_LINK_SECRET=cambia-esta-cadena-por-otra-aleatoria

# Datos FICTICIOS del emisor que salen en la factura.
# KN_COMPANY_NAME="Kitsune Notes Studio S.L."
# KN_COMPANY_TAX_ID=B00000000
# KN_COMPANY_ADDRESS="Calle del Ejemplo 1, 1.º A"
# KN_COMPANY_EMAIL=pedidos@kitsunenotes.test

# --- Envío real de correos (opcional) --------------------------------
# Por defecto la tienda NO envía correo de verdad: todo queda en el buzón
# de pruebas del back-office (Admin → Correos). Para que, por ejemplo, la
# factura llegue a tu bandeja de entrada, activa el envío por SMTP con TU
# cuenta de correo (ejemplo para Gmail: contraseña de aplicación, ver README).
#
# Estos datos solo deben estar en tu fichero .env local. No los subas al
# repositorio, no los copies en la memoria y no los pegues en ningún chat.
#
# KN_MAIL_TRANSPORT=smtp
# KN_SMTP_HOST=smtp.gmail.com
# KN_SMTP_PORT=587
# KN_SMTP_ENCRYPTION=tls
# KN_SMTP_USER=tu.cuenta@gmail.com
# KN_SMTP_PASS=la-contraseña-de-aplicación
# KN_MAIL_FROM=tu.cuenta@gmail.com
#
# Direcciones (separadas por comas) a las que SÍ se permite enviar correo
# real. A cualquier otra se la trata como siempre: solo buzón de pruebas.
# Sin esta línea no se envía nada, aunque lo demás esté configurado.
# KN_MAIL_ALLOWED_TO=tu.cuenta@gmail.com
#
# Solo si en Windows aparece un error de certificado (ver README):
# KN_SMTP_CAFILE=C:\php\cacert.pem

# --- Idiomas y monedas -----------------------------------------------
# La tienda vende en euros (español) y en libras (inglés). Tipo de cambio
# FIJO de demostración: libras por cada euro. No es un tipo oficial; el que
# se aplica a cada pedido queda guardado en el propio pedido.
# KN_FX_EUR_GBP=0.85

# --- Instrumentación -------------------------------------------------
KN_EVENT_LOG_ENABLED=1
# KN_EVENT_LOG_PATH=/ruta/absoluta/storage/events
