# Kitsune Gestión · configuración (copia este fichero como .env; el .env NO se sube a GitHub).
# Todos los valores de este ejemplo son ficticios o de demostración.

# Dirección pública del back-office (se usa en los enlaces que envía n8n).
KG_APP_URL=http://localhost:8100
KG_APP_DEBUG=1

# Base de datos propia (SQLite). Por defecto: storage/gestion.sqlite
#KG_DB_PATH=

# Usuario del equipo que se crea la primera vez. CAMBIA la contraseña en el servidor.
KG_ADMIN_EMAIL=gestion@kitsunenotes.test
KG_ADMIN_PASSWORD=gestion-demo-2026

# Claves de la API (cabecera X-Api-Key). Genera dos valores largos y distintos:
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# La de n8n tiene permisos de integración; la del agente solo consulta y clasifica.
KG_CLAVE_N8N=
KG_CLAVE_AGENTE=

# Webhook de n8n que recibe los cambios del back-office (flujo «03 · Eventos del back-office»)
# y el secreto compartido con n8n para firmarlos (HMAC-SHA256). El mismo valor va en n8n
# como KITSUNE_SECRETO_GESTION.
KG_N8N_WEBHOOK_URL=
KG_N8N_SECRETO=
# Segundos de espera por la respuesta de n8n (Render gratuito tarda ~1 min en despertar).
KG_N8N_TIMEOUT=20
